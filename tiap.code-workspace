{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"go.lintTool": "golangci-lint-v2",
		"go.alternateTools": {
			"customFormatter": "golangci-lint-v2"
		},
		"go.formatTool": "custom",
		"go.formatFlags": [
			"fmt",
			"--stdin"
		],
		"go.testTimeout": "300s",
		"go.testFlags": [
			"-v",
			"-race",
			"--",
			"-ginkgo.v",
			"-ginkgo.no-color"
		],
		"gopls": {
			"ui.semanticTokens": true,
			// https://github.com/golang/vscode-go/blob/master/docs/settings.md#uidiagnosticanalyses
			"ui.diagnostic.analyses": {},
			// https://github.com/golang/vscode-go/blob/master/docs/settings.md#uicodelenses
			"ui.codelenses": {
				"vulncheck": true,
			}
		},
		"markdown.styles": [
			"./.vscode/markdown-preview.css"
		],
		"statsBar.memoUsage.format": "$(chip) ${used}/${total} ${unit}, ${percent}%",
		"statsBar.location": "Right",
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Debug/Test Package",
				"type": "go",
				"request": "launch",
				"mode": "auto",
				"program": "${fileDirname}"
			},
			{
				"name": "Debug tiap Command",
				"type": "go",
				"request": "launch",
				"mode": "debug",
				"program": "${workspaceFolder}/cmd/tiap",
				"args": [
					"--debug",
					"--pull-always",
					"-o", "/tmp/hellorld.app",
					"${workspaceFolder}/testdata/app"
				]
			}
		],
		"compounds": []
	},
	"extensions": {
		"recommendations": [
			"ms-vscode.live-server",
			"njzy.stats-bar"
		]
	}
}